source ~/zephyrproject/.venv/bin/activate
export ZEPHYR_BASE=~/zephyrproject/zephyr

# Stick the Zephyr sdk commands in the path.  This is the SDK Zephyr main
# builds with, for gdb and objcopy outside of west.
export PATH="$HOME/.local/opt/zephyr-sdk-1.0.0/gnu/arm-zephyr-eabi/bin:$PATH"

# bindgen (zephyr-sys) has to take its built-in headers from the same clang
# as its libclang, or it mixes Xcode's with Homebrew's and fails on thumbv6m
# with "load and store exclusive builtins are not available".  The same
# recipe as zephyr-lang-rust's wbuild.sh.
if [[ "$(uname -s)" == Darwin ]]; then
	export LIBCLANG_PATH=/opt/homebrew/opt/llvm/lib
	export BINDGEN_EXTRA_CLANG_ARGS="-resource-dir=$(/opt/homebrew/opt/llvm/bin/clang -print-resource-dir)"
fi
