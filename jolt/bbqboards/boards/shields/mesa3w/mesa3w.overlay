/* Device tree overlay for the mesa3w keyboard, on the xiao_ble board
 *
 * The mesa3w is a new left board for the mesa3: a Seeed XIAO nRF52840 Plus in
 * place of the Tiny 2040, with the mesa3's passive right half unchanged over
 * the RJ-45.  It keeps the mesa3b's matrix, every key in the same (column,
 * row), so the firmware translates it with the mesa3b's table; the board-info
 * name, "mesa3w", is what tells them apart.  The pin map is mesa3w-left's
 * PCB, through the XIAO Plus pad table.
 *
 * The module's own USB-C is the keyboard's, and its 3.3 V LDO the rail, so
 * nothing here configures power.  Four white LEDs on D7..D10 (P1.12..P1.15),
 * anodes on 3V3 and sunk through 560 ohms, are the modifier indicator.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/battery/battery.h>

/* MCUboot at 0x27000, jolt in slot 0 after it, slot 1 on the QSPI flash. */
#include "mesa3w-partitions.dtsi"

/ {
	aliases {
		matrix = &kbd_matrix;
	};

	chosen {
		zephyr,code-partition = &slot0_partition;

		zephyr,matrix = &kbd_matrix;
		bbq,mono-leds = &mono_leds;

		/* The board's console is a CDC ACM port on the USB controller,
		 * which would be a second USB device beside jolt's.  The console
		 * is RTT, over the Tag-Connect. */
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
		/delete-property/ zephyr,bt-mon-uart;
		/delete-property/ zephyr,bt-c2h-uart;
	};

	/* The last 4 KiB page of the storage partition, which is cut short to
	 * make room, so that settings (Bluetooth bonds, later) can never erase
	 * it.  Below the UF2 bootloader, and outside the application. */
	board_info: board-info@f3000 {
		compatible = "bbq,board-info";
		reg = <0xf3000 0x100>;
		status = "okay";
	};

	/* The names are swapped here, and that is deliberate, as on the mesa3.
	 * The diodes conduct from the board's rows to its columns, so the
	 * scanner drives the board's *rows* and senses its *columns*; it
	 * drives `col-gpios` and senses `row-gpios`, so the board's rows go in
	 * `col-gpios`.  Both in board order, ROW_A and COL_1 first, which keeps
	 * the scan codes at ROW_x * 5 + COL_n as the translation table expects.
	 *
	 * The XIAO runs at 3.3 V, so the silicon diodes leave the sensing plenty
	 * of margin with standard drive; plan-mesa3w.md's 3.0 V worries were
	 * for the nPM1100 design this board replaced.
	 */
	kbd_matrix: kbd-matrix {
		compatible = "bbq,keyboard-matrix";
		row-gpios = <&gpio0 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>,  /* COL_1, D0 */
			    <&gpio0 3 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>,  /* COL_2, D1 */
			    <&gpio0 28 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>, /* COL_3, D2 */
			    <&gpio0 29 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>, /* COL_4, D3 */
			    <&gpio0 15 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>; /* COL_5, D11 */
		col-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>,  /* ROW_A, D4 */
			    <&gpio0 5 GPIO_ACTIVE_HIGH>,  /* ROW_B, D5 */
			    <&gpio1 7 GPIO_ACTIVE_HIGH>,  /* ROW_C, D19 */
			    <&gpio1 11 GPIO_ACTIVE_HIGH>; /* ROW_D, D6 */
		idle-mode = "scan";
	};

	/* The four white LEDs, in board order, which is the indicator's slot
	 * order.  The pins sink the LEDs, so they are lit while low; jolt finds
	 * the children by these names. */
	mono_leds: mono-leds {
		compatible = "pwm-leds";

		led-0 {
			pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>; /* LED1, D7 */
		};

		led-1 {
			pwms = <&pwm1 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>; /* LED2, D8 */
		};

		led-2 {
			pwms = <&pwm1 2 PWM_MSEC(1) PWM_POLARITY_INVERTED>; /* LED3, D9 */
		};

		led-3 {
			pwms = <&pwm1 3 PWM_MSEC(1) PWM_POLARITY_INVERTED>; /* LED4, D10 */
		};
	};
};

&storage_partition {
	reg = <0x000ec000 0x00007000>;
};

/* The board puts uart0 on D6/D7, i2c1 on D4/D5 and spi2 on D8..D10: ROW_D,
 * ROW_A, ROW_B and three of the four LEDs here. */
&uart0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&board_cdc_acm_uart {
	status = "disabled";
};

/* The QSPI flash, a P25Q16H, is suspended (in deep power-down) as soon as
 * its driver has initialized it, and again a few milliseconds after each
 * use; the driver resumes it for each operation.  Its init leaves it in
 * standby, about 13 uA more, which is why this is not left to the default.
 * The driver's init also takes it out of deep power-down, so a reset, or a
 * wake from System OFF, comes back through here. */
&p25q16h {
	zephyr,pm-device-runtime-auto;
};

/* The LEDs on D7..D10.  `nordic,invert` idles the pins high, so the LEDs stay
 * dark until the PWM drives them. */
&pinctrl {
	pwm1_default: pwm1_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 12)>,
				<NRF_PSEL(PWM_OUT1, 1, 13)>,
				<NRF_PSEL(PWM_OUT2, 1, 14)>,
				<NRF_PSEL(PWM_OUT3, 1, 15)>;
			nordic,invert;
		};
	};

	pwm1_sleep: pwm1_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 12)>,
				<NRF_PSEL(PWM_OUT1, 1, 13)>,
				<NRF_PSEL(PWM_OUT2, 1, 14)>,
				<NRF_PSEL(PWM_OUT3, 1, 15)>;
			low-power-enable;
		};
	};
};

&pwm1 {
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

/* The module's battery divider runs VBAT -> 1M -> P0.31 -> 510k -> P0.14, so
 * P0.14 is the divider's ground.  Left at reset, P0.14 floats, nothing pulls
 * the divider down, and P0.31 and P0.14 both rise toward VBAT: up to 4.2 V
 * from the cell or the charger, past the 3.6 V (VDD + 0.3 V) limit on either
 * pin.  Driving it low keeps P0.31 at a third of VBAT, about 1.4 V, at a cost
 * of under 3 uA through the divider.  `vbatt` below deliberately does not take
 * this pin as its power-gpios: switching the divider off between readings is
 * exactly what lets the pins rise. */
&gpio0 {
	read-bat-enable {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

/* The battery: `vbatt` reads the divider above on P0.31 (AIN7), and `battery`
 * turns its voltage into a charge through Zephyr's stock Li-po curve, for the
 * Battery Service (battery.c).  P0.31 sits at a third of VBAT, 1.42 V at
 * most, inside the 1.8 V that the internal 0.6 V reference gives at gain 1/3.
 * The divider is 338k seen from the pin, which the SAADC wants 40 us to
 * sample.
 */
/ {
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		output-ohms = <510000>;
		full-ohms = <(1000000 + 510000)>;
	};

	battery: battery {
		compatible = "zephyr,fuel-gauge-composite";
		source-primary = <&vbatt>;
		device-chemistry = "lithium-ion-polymer";
		ocv-capacity-table-0 = <BATTERY_OCV_CURVE_LITHIUM_ION_POLYMER_DEFAULT>;
	};

	/* The charger's (BQ25101) CHG, on P0.17 inside the module: open drain,
	 * low while charging, and also what lights the charge LED.  Open drain
	 * needs the pull-up, which costs about 250 uA only while charging, on
	 * USB power. */
	zephyr,user {
		charging-gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&adc {
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_3";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};
