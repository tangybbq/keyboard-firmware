logs := env_var("HOME") / "Library/Application Support/TaipoTeacher/logs"
extract := "extract/target/release/keyvid-extract"
# The trainer names each day's log by the local date.
today := datetime("%F")

# List a day's sessions, each line of text with the times it was typed between.
list day:
	cargo build -q --release --manifest-path extract/Cargo.toml
	{{extract}} "{{logs}}/{{day}}.txt" --list

# Cut a clip out of a day's log: `just clip 2026-09-28 0 1842000 1852000 orsy-directed`.
clip day session from to name:
	cargo build -q --release --manifest-path extract/Cargo.toml
	mkdir -p clips
	{{extract}} "{{logs}}/{{day}}.txt" --session {{session}} --from {{from}} --to {{to}} -o clips/{{name}}.json

# The runs of a day: each stretch typed in one mode, between two switches.
runs day=today:
	cargo build -q --release --manifest-path extract/Cargo.toml
	{{extract}} "{{logs}}/{{day}}.txt" --runs

# Switch to Orsy, type, switch back, then `just last orsy hello`.
# Cut the last finished run in MODE from a day's log (today's by default) and render it.
last mode name speed="1" quality="m" day=today:
	cargo build -q --release --manifest-path extract/Cargo.toml
	mkdir -p clips
	{{extract}} "{{logs}}/{{day}}.txt" --last {{mode}} -o clips/{{name}}.json
	just render {{name}} {{speed}} {{quality}}

# Cut run N (negative counts back from the latest) of a day, as `just runs` numbers them.
run n name day=today:
	cargo build -q --release --manifest-path extract/Cargo.toml
	mkdir -p clips
	{{extract}} "{{logs}}/{{day}}.txt" --run {{n}} -o clips/{{name}}.json

# Manim's cache is off.  It keys on a hash of the scene's objects, which does
# not see everything the clock-driven updater draws from, and a clip is one
# long animation, so it saves nothing and could hand back a stale render.
manim := "uv run manim --disable_caching"

# Speed 0.5 is half speed; quality is l, m, h or k (480p to 4K).
# Render a clip, replacing any earlier video of the same name.
render name speed="1" quality="m":
	KEYVID_CLIP=clips/{{name}}.json KEYVID_SPEED={{speed}} {{manim}} -q{{quality}} -o {{name}}.mp4 scenes.py Replay

# Render and open the result.
preview name speed="1":
	KEYVID_CLIP=clips/{{name}}.json KEYVID_SPEED={{speed}} {{manim}} -pql -o {{name}}.mp4 scenes.py Replay

# With no name, also manim's leftovers: its text cache and partial movies.
# Delete a clip's videos at every quality, or every render; the clips stay.
clean name="":
	{{ if name == "" { "rm -rf media" } else { "rm -f media/videos/scenes/*/" + name + ".mp4" } }}
